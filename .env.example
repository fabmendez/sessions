# For local use, leave this empty and run `npm run local` (or double-click start.cmd on Windows):
# it starts a built-in database, so there's nothing to install.
#
# For a real PostgreSQL server (production, VPS, Docker), set it and use `npm run dev` / `npm start`:
# DATABASE_URL=postgres://postgres:password@localhost:5432/session
DATABASE_URL=
