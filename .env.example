# For local use, leave this empty and run `npm run local` (or double-click start.cmd on Windows):
# it starts a built-in database, so there's nothing to install.
#
# For a real PostgreSQL server (production, VPS, Docker), set it and use `npm run dev` / `npm start`:
# DATABASE_URL=postgres://postgres:password@localhost:5432/session
DATABASE_URL=

# Session is invite-only. Admins (comma-separated emails) approve members' invites at /admin.
ADMIN_EMAILS=lewis@session.test
# How many invites each member can have out at once.
INVITES_PER_MEMBER=5
# Public address used in invite links. Optional: worked out from the request when empty.
APP_URL=
# Optional: email invite links through resend.com. Without these, copy the link and send it yourself.
RESEND_API_KEY=
EMAIL_FROM=
